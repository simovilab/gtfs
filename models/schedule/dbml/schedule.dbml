Note: 'This document defines the format and structure of the files that comprise a GTFS dataset.'
}

enum gtfs.agency_cemv_support_options {
 "0 or empty" [note: 'No cEMV information for trips associated with this agency.']
 "1" [note: 'Riders may use cEMVs as fare media for trips associated with this agency.']
 "2" [note: 'cEMVs are not supported as fare media for trips associated with this agency.']
}

enum gtfs.stops_location_type_options {
 "0 (or empty)" [note: 'Stop (or Platform). A location where passengers board or disembark from a transit vehicle. Is called a platform when defined within a parent_station.']
 "1" [note: 'Station. A physical structure or area that contains one or more platform.']
 "2" [note: 'Entrance/Exit. A location where passengers can enter or exit a station from the street. If an entrance/exit belongs to multiple stations, it may be linked by pathways to both, but the data provider must pick one of them as parent.']
 "3" [note: 'Generic Node. A location within a station, not matching any other location_type, that may be used to link together pathways define in pathways.txt.']
 "4" [note: 'Boarding Area. A specific location on a platform, where passengers can board and/or alight vehicles.']
}

enum gtfs.stops_stop_access_options {
 "0" [note: 'The stop/platform cannot be directly accessed from the street network. It must be accessed from a station entrance if there is one defined for the station, otherwise the station itself. If there are pathways defined for the station, they must be used to access the stop/platform.']
 "1" [note: 'Consuming applications should generate directions for access directly to the stop, independent of any entrances or pathways of the parent station.']
}

enum gtfs.routes_route_type_options {
 "0" [note: 'Tram, Streetcar, Light rail. Any light rail or street level system within a metropolitan area.']
 "1" [note: 'Subway, Metro. Any underground rail system within a metropolitan area.']
 "2" [note: 'Rail. Used for intercity or long-distance travel.']
 "3" [note: 'Bus. Used for short- and long-distance bus routes.']
 "4" [note: 'Ferry. Used for short- and long-distance boat service.']
 "5" [note: 'Cable tram. Used for street-level rail cars where the cable runs beneath the vehicle (e.g., cable car in San Francisco).']
 "6" [note: 'Aerial lift, suspended cable car (e.g., gondola lift, aerial tramway). Cable transport where cabins, cars, gondolas or open chairs are suspended by means of one or more cables.']
 "7" [note: 'Funicular. Any rail system designed for steep inclines.']
 "11" [note: 'Trolleybus. Electric buses that draw power from overhead wires using poles.']
 "12" [note: 'Monorail. Railway in which the track consists of a single rail or a beam.']
}

enum gtfs.routes_continuous_pickup_options {
 "0" [note: 'Continuous stopping pickup.']
 "1 or empty" [note: 'No continuous stopping pickup.']
 "2" [note: 'Must phone agency to arrange continuous stopping pickup.']
 "3" [note: 'Must coordinate with driver to arrange continuous stopping pickup.']
