Table gtfs.agency {
agency_id string [pk, note: "Identifies a transit brand which is often synonymous with a transit agency. Note that in some cases, such as when a single agency operates multiple separate services, agencies and brands are distinct. This document uses the term \"agency\" in place of \"brand\". A dataset may contain data from multiple agencies."]
agency_name string [not null, note: "Full name of the transit agency."]
agency_url string [not null, note: "URL of the transit agency."]
agency_timezone string [not null, note: "Timezone where the transit agency is located. If multiple agencies are specified in the dataset, each must have the same agency_timezone."]
agency_lang string [note: "Primary language used by this transit agency. Should be provided to help GTFS consumers choose capitalization rules and other language-specific settings for the dataset."]
agency_phone string [note: "A voice telephone number for the specified agency. This field is a string value that presents the telephone number as typical for the agency's service area. It may contain punctuation marks to group the digits of the number. Dialable text (for example, TriMet's \"503-238-RIDE\") is permitted, but the field must not contain any other descriptive text."]
agency_fare_url string [note: "URL of a web page where a rider can purchase tickets or other fare instruments for that agency, or a web page containing information about that agency's fares."]
agency_email string [note: "Email address actively monitored by the agency's customer service department. This email address should be a direct contact point where transit riders can reach a customer service representative at the agency."]
cemv_support gtfs.agency_cemv_support_options [note: "Indicates if riders can access a transit service (i.e., trip) associated with this agency by using a contactless EMV (Europay, Mastercard, and Visa) card or mobile device as fare media at a fare validator (such as in pay-as-you-go or open-loop systems). This field does not indicate that cEMV can be used to purchase other fare products or to add value to another fare media. Support for cEMVs should only be indicated if all services under this agency are accessible with the use of cEMV cards or mobile devices as fare media. If both agency.cemv_support and routes.cemv_support are provided for the same service, the value in routes.cemv_support shall take precedence. This field is independent of all other fare-related files and may be used separately. If there is conflicting information between this field and any fare-related file (such as fare_media.txt, fare_products.txt, or fare_leg_rules.txt), the information in those files shall take precedence over agency.cemv_support."]
Note: 'Transit agencies with service represented in this dataset.'
}

Table gtfs.stops {
stop_id string [not null, pk, note: "Identifies a location: stop/platform, station, entrance/exit, generic node or boarding area (see location_type). ['ID must be unique across all stops.stop_id, locations.geojson id, and location_groups.location_group_id values.', 'Multiple routes may use the same stop_id.']"]
stop_code string [note: "Short text or a number that identifies the location for riders. These codes are often used in phone-based transit information systems or printed on signage to make it easier for riders to get information for a particular location. The stop_code may be the same as stop_id if it is public facing. This field should be left empty for locations without a code presented to riders."]
stop_name string [note: "Name of the location. The stop_name should match the agency's rider-facing name for the location as printed on a timetable, published online, or represented on signage. For translations into other languages, use translations.txt. When the location is a boarding area (location_type=4), the stop_name should contains the name of the boarding area as displayed by the agency. It could be just one letter (like on some European intercity railway stations), or text like \"Wheelchair boarding area\" (NYC's Subway) or \"Head of short trains\" (Paris' RER)."]
tts_stop_name string [note: "Readable version of the stop_name. See \"Text-to-speech field\" in the Term Definitions for more."]
stop_desc string [note: "Description of the location that provides useful, quality information. Should not be a duplicate of stop_name."]
stop_lat float [note: "Latitude of the location. For stops/platforms (location_type=0) and boarding area (location_type=4), the coordinates must be the ones of the bus pole — if exists — and otherwise of where the travelers are boarding the vehicle (on the sidewalk or the platform, and not on the roadway or the track where the vehicle stops)."]
stop_lon float [note: "Longitude of the location. For stops/platforms (location_type=0) and boarding area (location_type=4), the coordinates must be the ones of the bus pole — if exists — and otherwise of where the travelers are boarding the vehicle (on the sidewalk or the platform, and not on the roadway or the track where the vehicle stops)."]
zone_id string [note: "Identifies the fare zone for a stop. If this record represents a station or station entrance, the zone_id is ignored."]
stop_url string [note: "URL of a web page about the location. This should be different from the agency.agency_url and the routes.route_url field values."]
location_type gtfs.stops_location_type_options [note: "Location type."]
parent_station string [ref: > gtfs.stops.stop_id, note: "Defines hierarchy between the different locations defined in stops.txt. It contains the ID of the parent location, as followed: Stop/platform (location_type=0): the parent_station field contains the ID of a station. Station (location_type=1): this field must be empty. Entrance/exit (location_type=2) or generic node (location_type=3): the parent_station field contains the ID of a station (location_type=1). Boarding Area (location_type=4): the parent_station field contains ID of a platform."]
stop_timezone string [note: "Timezone of the location. If the location has a parent station, it inherits the parent station's timezone instead of applying its own. Stations and parentless stops with empty stop_timezone inherit the timezone specified by agency.agency_timezone. The times provided in stop_times.txt are in the timezone specified by agency.agency_timezone, not stop_timezone. This ensures that the time values in a trip always increase over the course of a trip, regardless of which timezones the trip crosses."]
wheelchair_boarding gtfs.stops_wheelchair_boarding_options [note: "Indicates whether wheelchair boardings are possible from the location."]
level_id string [note: "Level of the location. The same level may be used by multiple unlinked stations."]
platform_code string [note: "Platform identifier for a platform stop (a stop belonging to a station). This should be just the platform identifier (eg. \"G\" or \"3\"). Words like \"platform\" or \"track\" (or the feed's language-specific equivalent) should not be included. This allows feed consumers to more easily internationalize and localize the platform identifier into other languages."]
stop_access gtfs.stops_stop_access_options [note: "Indicates how the stop is accessed for a particular station. When stop_access is empty, the access for the specified stop or platform is considered undefined."]
Note: 'Stops where vehicles pick up or drop off riders. Also defines stations and station entrances.'
}

Table gtfs.routes {
route_id string [not null, pk, note: "Identifies a route."]
agency_id string [ref: > gtfs.agency.agency_id, note: "Agency for the specified route."]
route_short_name string [note: "Short name of a route. Often a short, abstract identifier (e.g., \"32\", \"100X\", \"Green\") that riders use to identify a route. Both route_short_name and route_long_name may be defined."]
route_long_name string [note: "Full name of a route. This name is generally more descriptive than the route_short_name and often includes the route's destination or stop. Both route_short_name and route_long_name may be defined."]
route_desc string [note: "Description of a route that provides useful, quality information. Should not be a duplicate of route_short_name or route_long_name."]
route_type gtfs.routes_route_type_options [not null, note: "Indicates the type of transportation used on a route."]
route_url string [note: "URL of a web page about the particular route. Should be different from the agency.agency_url value."]
route_color string [note: "Route color designation that matches public facing material. Defaults to white (FFFFFF) when omitted or left empty. The color difference between route_color and route_text_color should provide sufficient contrast when viewed on a black and white screen."]
route_text_color string [note: "Legible color to use for text drawn against a background of route_color. Defaults to black (000000) when omitted or left empty. The color difference between route_color and route_text_color should provide sufficient contrast when viewed on a black and white screen."]
route_sort_order int [note: "Orders the routes in a way which is ideal for presentation to customers. Routes with smaller route_sort_order values should be displayed first."]
continuous_pickup gtfs.routes_continuous_pickup_options [note: "Indicates that the rider can board the transit vehicle at any point along the vehicle's travel path as described by shapes.txt, on every trip of the route. Values for routes.continuous_pickup may be overridden by defining values in stop_times.continuous_pickup for specific stop_times along the route."]
continuous_drop_off gtfs.routes_continuous_drop_off_options [note: "Indicates that the rider can alight from the transit vehicle at any point along the vehicle's travel path as described by shapes.txt, on every trip of the route. Values for routes.continuous_drop_off may be overridden by defining values in stop_times.continuous_drop_off for specific stop_times along the route."]
network_id string [note: "Identifies a group of routes. Multiple rows in routes.txt may have the same network_id."]
cemv_support gtfs.routes_cemv_support_options [note: "Indicates if riders can access a transit service (i.e., trip) associated with this route by using a contactless EMV (Europay, Mastercard, and Visa) card or mobile device as fare media at a fare validator (such as in pay-as-you-go or open-loop systems). This field does not indicate that cEMV can be used to purchase other fare products or to add value to another fare media. Support for cEMVs should only be indicated if all services under this route are accessible with the use of cEMV cards or mobile devices as fare media. If both agency.cemv_support and routes.cemv_support are provided for the same service, the value in routes.cemv_support shall take precedence. This field is independent of all other fare-related files and may be used separately. If there is conflicting information between this field and any fare-related file (such as fare_media.txt, fare_products.txt, or fare_leg_rules.txt), the information in those files shall take precedence over agency.cemv_support."]
Note: 'Transit routes. A route is a group of trips that are displayed to riders as a single service.'
}

Table gtfs.shapes {
shape_id string [not null, pk, note: "Identifies a shape."]
shape_pt_lat float [not null, note: "Latitude of a shape point. Each record in shapes.txt represents a shape point used to define the shape."]
shape_pt_lon float [not null, note: "Longitude of a shape point."]
shape_pt_sequence int [not null, pk, note: "Sequence in which the shape points connect to form the shape. Values must increase along the trip but do not need to be consecutive."]
shape_dist_traveled float [note: "Actual distance traveled along the shape from the first shape point to the point specified in this record. Used by trip planners to show the correct portion of the shape on a map. Values must increase along with shape_pt_sequence; they must not be used to show reverse travel along a route. Distance units must be consistent with those used in stop_times.txt. Recommended for routes that have looping or inlining (the vehicle crosses or travels over the same portion of alignment in one trip). If a vehicle retraces or crosses the route alignment at points in the course of a trip, shape_dist_traveled is important to clarify how portions of the points in shapes.txt line up correspond with records in stop_times.txt."]
Note: 'Rules for mapping vehicle travel paths, sometimes referred to as route alignments.'
}

Table gtfs.calendar {
service_id string [not null, pk, note: "Identifies a set of dates when service is available for one or more routes."]
monday gtfs.calendar_monday_options [not null, note: "Indicates whether the service operates on all Mondays in the date range specified by the start_date and end_date fields. Note that exceptions for particular dates may be listed in calendar_dates.txt."]
tuesday gtfs.calendar_tuesday_options [not null, note: "Functions in the same way as monday except applies to Tuesdays."]
wednesday gtfs.calendar_wednesday_options [not null, note: "Functions in the same way as monday except applies to Wednesdays."]
thursday gtfs.calendar_thursday_options [not null, note: "Functions in the same way as monday except applies to Thursdays."]
friday gtfs.calendar_friday_options [not null, note: "Functions in the same way as monday except applies to Fridays."]
saturday gtfs.calendar_saturday_options [not null, note: "Functions in the same way as monday except applies to Saturdays."]
sunday gtfs.calendar_sunday_options [not null, note: "Functions in the same way as monday except applies to Sundays."]
start_date date [not null, note: "Start service day for the service interval."]
end_date date [not null, note: "End service day for the service interval. This service day is included in the interval."]
Note: 'Service dates specified using a weekly schedule with start and end dates.'
}

Table gtfs.trips {
route_id string [not null, ref: > gtfs.routes.route_id, note: "Identifies a route."]
service_id string [not null, ref: > gtfs.calendar.service_id, note: "Identifies a set of dates when service is available for one or more routes."]
trip_id string [not null, pk, note: "Identifies a trip."]
trip_headsign string [note: "Text that appears on signage identifying the trip's destination to riders."]
trip_short_name string [note: "Public-facing text used to identify the trip to riders, for instance, to identify train numbers for commuter rail trips."]
direction_id gtfs.trips_direction_id_options [note: "Indicates the direction of travel for a trip."]
block_id string [note: "Identifies the block to which the trip belongs."]
shape_id string [ref: > gtfs.shapes.shape_id, note: "Identifies a geospatial shape describing the vehicle travel path for a trip."]
wheelchair_accessible gtfs.trips_wheelchair_accessible_options [note: "Indicates wheelchair accessibility."]
bikes_allowed gtfs.trips_bikes_allowed_options [note: "Indicates whether bikes are allowed."]
cars_allowed gtfs.trips_cars_allowed_options [note: "Indicates whether cars are allowed."]
Note: 'Trips for each route. A trip is a sequence of two or more stops that occur during a specific time period.'
}

Table gtfs.stop_times {
trip_id string [not null, pk, ref: > gtfs.trips.trip_id, note: "Identifies a trip."]
arrival_time time [note: "Arrival time at the stop (defined by stop_times.stop_id) for a specific trip (defined by stop_times.trip_id) in the time zone specified by agency.agency_timezone, not stops.stop_timezone. ['If there are not separate times for arrival and departure at a stop, arrival_time and departure_time should be the same.', 'For times occurring after midnight on the service day, enter the time as a value greater than 24:00:00 in HH:MM:SS.', 'If exact arrival and departure times (timepoint=1) are not available, estimated or interpolated arrival and departure times (timepoint=0) should be provided.']"]
departure_time time [note: "Departure time from the stop (defined by stop_times.stop_id) for a specific trip (defined by stop_times.trip_id) in the time zone specified by agency.agency_timezone, not stops.stop_timezone. ['If there are not separate times for arrival and departure at a stop, arrival_time and departure_time should be the same.', 'For times occurring after midnight on the service day, enter the time as a value greater than 24:00:00 in HH:MM:SS.', 'If exact arrival and departure times (timepoint=1) are not available, estimated or interpolated arrival and departure times (timepoint=0) should be provided.']"]
stop_id string [ref: > gtfs.stops.stop_id, note: "Identifies the serviced stop. ['All stops serviced during a trip must have a record in stop_times.txt. Referenced locations must be stops/platforms, i.e. their stops.location_type value must be 0 or empty. A stop may be serviced multiple times in the same trip, and multiple trips and routes may service the same stop.', 'On-demand service using stops should be referenced in the sequence in which service is available at those stops. A data consumer should assume that travel is possible from one stop or location to any stop or location later in the trip, provided that the pickup/drop_off_type of each stop_time and the time constraints of each start/end_pickup_drop_off_window do not forbid it.']"]
location_group_id string [ref: > gtfs.location_groups.location_group_id, note: "Identifies the serviced location group that indicates groups of stops where riders may request pickup or drop off. ['All location groups serviced during a trip must have a record in stop_times.txt. Multiple trips and routes may service the same location group.', 'On-demand service using location groups should be referenced in the sequence in which service is available at those location groups. A data consumer should assume that travel is possible from one stop or location to any stop or location later in the trip, provided that the pickup/drop_off_type of each stop_time and the time constraints of each start/end_pickup_drop_off_window do not forbid it.']"]
location_id string [ref: > gtfs.locations.geojson id, note: "Identifies the GeoJSON location that corresponds to serviced zone where riders may request pickup or drop off. ['All GeoJSON locations serviced during a trip must have a record in stop_times.txt. Multiple trips and routes may service the same GeoJSON location.', 'On-demand service within locations should be referenced in the sequence in which service is available in those locations. A data consumer should assume that travel is possible from one stop or location to any stop or location later in the trip, provided that the pickup/drop_off_type of each stop_time and the time constraints of each start/end_pickup_drop_off_window do not forbid it.']"]
stop_sequence int [not null, pk, note: "Order of stops, location groups, or GeoJSON locations for a particular trip. The values must increase along the trip but do not need to be consecutive. ['Travel within the same location group or GeoJSON location requires two records in stop_times.txt with the same location_group_id or location_id.']"]
stop_headsign string [note: "Text that appears on signage identifying the trip's destination to riders. This field overrides the default trips.trip_headsign when the headsign changes between stops. If the headsign is displayed for an entire trip, trips.trip_headsign should be used instead. ['A stop_headsign value specified for one stop_time does not apply to subsequent stop_times in the same trip. If you want to override the trip_headsign for multiple stop_times in the same trip, the stop_headsign value must be repeated in each stop_time row.']"]
start_pickup_drop_off_window time [note: "Time that on-demand service becomes available in a GeoJSON location, location group, or stop."]
end_pickup_drop_off_window time [note: "Time that on-demand service ends in a GeoJSON location, location group, or stop."]
pickup_type gtfs.stop_times_pickup_type_options [note: "Indicates drop off method."]
drop_off_type gtfs.stop_times_drop_off_type_options [note: "Indicates drop off method."]
continuous_pickup gtfs.stop_times_continuous_pickup_options [note: "Indicates that the rider can board the transit vehicle at any point along the vehicle’s travel path as described by shapes.txt, from this stop_time to the next stop_time in the trip's stop_sequence. ['If this field is populated, it overrides any continuous pickup behavior defined in routes.txt. If this field is empty, the stop_time inherits any continuous pickup behavior defined in routes.txt.']"]
continuous_drop_off gtfs.stop_times_continuous_drop_off_options [note: "Indicates that the rider can alight from the transit vehicle at any point along the vehicle’s travel path as described by shapes.txt, from this stop_time to the next stop_time in the trip's stop_sequence. ['If this field is populated, it overrides any continuous drop-off behavior defined in routes.txt. If this field is empty, the stop_time inherits any continuous drop-off behavior defined in routes.txt.']"]
shape_dist_traveled float [note: "Actual distance traveled along the associated shape, from the first stop to the stop specified in this record. This field specifies how much of the shape to draw between any two stops during a trip. ['Must be in the same units used in shapes.txt.', 'Values used for shape_dist_traveled must increase along with stop_sequence; they must not be used to show reverse travel along a route.', 'Recommended for routes that have looping or inlining (the vehicle crosses or travels over the same portion of alignment in one trip).', 'See shapes.shape_dist_traveled.']"]
timepoint gtfs.stop_times_timepoint_options [note: "Indicates if arrival and departure times for a stop are strictly adhered to by the vehicle or if they are instead approximate and/or interpolated times. ['This field allows a GTFS producer to provide interpolated stop-times, while indicating that the times are approximate.', 'All records of stop_times.txt with defined arrival or departure times should have timepoint values populated.', 'If no timepoint values are provided, all times are considered exact.']"]
pickup_booking_rule_id string [ref: > gtfs.booking_rules.booking_rule_id, note: "Identifies the boarding booking rule at this stop time. ['Recommended when pickup_type=2.']"]
drop_off_booking_rule_id string [ref: > gtfs.booking_rules.booking_rule_id, note: "Identifies the alighting booking rule at this stop time. ['Recommended when drop_off_type=2.']"]
Note: 'Times that a vehicle arrives at and departs from stops for each trip.'
}

Table gtfs.calendar_dates {
service_id string [not null, pk, note: "Identifies a set of dates when a service exception occurs for one or more routes. Each (service_id, date) pair may only appear once in calendar_dates.txt if using calendar.txt and calendar_dates.txt in conjunction. If a service_id value appears in both calendar.txt and calendar_dates.txt, the information in calendar_dates.txt modifies the service information specified in calendar.txt."]
date date [not null, pk, note: "Date when service exception occurs."]
exception_type gtfs.calendar_dates_exception_type_options [not null, note: "Indicates whether service is available on the date specified in the date field.<hr>*Example:* Suppose a route has one set of trips available on holidays and another set of trips available on all other days. One service_id could correspond to the regular service schedule and another service_id could correspond to the holiday schedule. For a particular holiday, the calendar_dates.txt file could be used to add the holiday to the holiday service_id and to remove the holiday from the regular service_id schedule."]
Note: 'Exceptions for the services defined in the calendar.txt.'
}

Table gtfs.fare_attributes {
fare_id string [not null, pk, note: "Identifies a fare class."]
price float [not null, note: "Fare price, in the unit specified by currency_type."]
currency_type string [not null, note: "Currency used to pay the fare."]
payment_method gtfs.fare_attributes_payment_method_options [not null, note: "Indicates when the fare must be paid."]
transfers gtfs.fare_attributes_transfers_options [not null, note: "Indicates the number of transfers permitted on this fare."]
agency_id string [note: "Identifies the relevant agency for a fare."]
transfer_duration int [note: "Length of time in seconds before a transfer expires. When transfers=0 this field may be used to indicate how long a ticket is valid for or it may be left empty."]
Note: 'Fare information for a transit agency's routes.'
}

Table gtfs.fare_rules {
fare_id string [not null, note: "Identifies a fare class."]
route_id string [note: "Identifies a route associated with the fare class. If several routes with the same fare attributes exist, create a record in fare_rules.txt for each route.<hr>*Example:* If fare class \"b\" is valid on route \"TSW\" and \"TSE\", fare_rules.txt would contain records: fare_id,route_id / b,TSW / b,TSE."]
origin_id string [note: "Identifies an origin zone. If a fare class has multiple origin zones, create a record in fare_rules.txt for each origin_id.<hr>*Example:* If fare class \"b\" is valid for all travel originating from either zone \"2\" or zone \"8\", fare_rules.txt would contain: fare_id,...,origin_id / b,...,2 / b,...,8."]
destination_id string [note: "Identifies a destination zone. If a fare class has multiple destination zones, create a record in fare_rules.txt for each destination_id.<hr>*Example:* The origin_id and destination_id fields can be used together to specify that fare class \"b\" is valid for travel between zones 3 and 4, and between zones 3 and 5: fare_id,...,origin_id,destination_id / b,...,3,4 / b,...,3,5."]
contains_id string [note: "Identifies the zones that a rider will enter while using a given fare class. Used in some systems to calculate correct fare class.<hr>*Example:* If fare class \"c\" is associated with all travel on the GRT route that passes through zones 5, 6, and 7, fare_rules.txt would contain records for contains_id 5, 6, and 7. Because all contains_id zones must be matched for the fare to apply, an itinerary that passes through zones 5 and 6 but not zone 7 would not have fare class \"c\"."]
Note: 'Rules to apply fares for itineraries.'
}

Table gtfs.timeframes {
timeframe_group_id string [not null, note: "Identifies a timeframe or set of timeframes."]
start_time time [note: "Defines the beginning of a timeframe. The interval includes the start time. Values greater than 24:00:00 are forbidden. An empty value in start_time is considered 00:00:00."]
end_time time [note: "Defines the end of a timeframe. The interval does not include the end time. Values greater than 24:00:00 are forbidden. An empty value in end_time is considered 24:00:00."]
service_id string [not null, note: "Identifies a set of dates that a timeframe is in effect."]
Note: 'Date and time periods to use in fare rules for fares that depend on date and time factors.'
}

Table gtfs.rider_categories {
rider_category_id string [not null, pk, note: "Identifies a rider category."]
rider_category_name string [not null, note: "Rider category name as displayed to the rider."]
is_default_fare_category gtfs.rider_categories_is_default_fare_category_options [not null, note: "Specifies if an entry in rider_categories.txt should be considered the default category. When multiple rider categories are eligible for a single fare product specified by a fare_product_id, there must be exactly one eligible rider category indicated as the default rider category (is_default_fare_category=1)."]
eligibility_url string [note: "URL of a web page that provides detailed information about a specific rider category and/or describes its eligibility criteria."]
Note: 'Defines categories of riders (e.g. elderly, student).'
}

Table gtfs.fare_media {
fare_media_id string [not null, pk, note: "Identifies a fare media."]
fare_media_name string [note: "Name of the fare media. For fare media which are transit cards (fare_media_type=2) or mobile apps (fare_media_type=4), fare_media_name should be included and should match the rider-facing name used by the organizations delivering them."]
fare_media_type gtfs.fare_media_fare_media_type_options [not null, note: "The type of fare media."]
Note: 'To describe the fare media that can be employed to use fare products.'
}

Table gtfs.fare_products {
fare_product_id string [not null, pk, note: "Identifies a fare product or set of fare products. Multiple records sharing the same fare_product_id are permitted as long as they contain different fare_media_id values or rider_category_id values."]
fare_product_name string [note: "The name of the fare product as displayed to riders."]
rider_category_id string [pk, note: "Identifies a rider category eligible for the fare product. If fare_products.rider_category_id is empty, the fare product is eligible for any rider_category_id. When multiple rider categories are eligible for a single fare product specified by a fare_product_id, there must be only one of these rider categories indicated as the default rider category (is_default_fare_category=1)."]
fare_media_id string [pk, note: "Identifies a fare media that can be employed to use the fare product during the trip. When fare_media_id is empty, it is considered that the fare media is unknown."]
amount float [not null, note: "The cost of the fare product. May be negative to represent transfer discounts. May be zero to represent a fare product that is free."]
currency string [not null, note: "The currency of the cost of the fare product."]
Note: 'To describe the different types of tickets or fares that can be purchased by riders.'
}

Table gtfs.fare_leg_rules {
leg_group_id string [note: "Identifies a group of entries in fare_leg_rules.txt. Used to describe fare transfer rules between fare_transfer_rules.from_leg_group_id and fare_transfer_rules.to_leg_group_id. Multiple entries may belong to the same leg_group_id. The same entry (not including leg_group_id) must not belong to multiple leg_group_id values."]
network_id string [pk, note: "Identifies a route network that applies for the fare leg rule. If rule_priority does not exist and there are no matching network_id values, empty network_id entries will be matched by default and correspond to all networks defined in routes.txt or networks.txt excluding the ones listed under fare_leg_rules.network_id. If rule_priority exists, an empty network_id indicates the route network of the leg does not affect the matching of this rule. When matching against an effective fare leg of multiple legs, each leg must have the same network_id."]
from_area_id string [pk, note: "Identifies a departure area. If rule_priority does not exist and there are no matching from_area_id values, empty from_area_id entries will be matched by default and correspond to all areas defined in areas.area_id excluding the ones listed under fare_leg_rules.from_area_id. If rule_priority exists, an empty from_area_id indicates the departure area does not affect the matching of this rule. When matching against an effective fare leg of multiple legs, the first leg is used for determining the departure area."]
to_area_id string [pk, note: "Identifies an arrival area. If rule_priority does not exist and there are no matching to_area_id values, empty to_area_id entries will be matched by default and correspond to all areas defined in areas.area_id excluding the ones listed under fare_leg_rules.to_area_id. If rule_priority exists, an empty to_area_id indicates the arrival area does not affect the matching of this rule. When matching against an effective fare leg of multiple legs, the last leg is used for determining the arrival area."]
from_timeframe_group_id string [pk, note: "Defines the timeframe for the fare validation event at the start of the fare leg. The start time is computed in local time as determined by the Local Time Semantics of timeframes.txt, using the stop or station of the fare leg's departure event for timezone resolution when appropriate. For a fare leg rule that specifies a from_timeframe_group_id, the rule matches a leg if there exists a record in timeframes.txt where: (1) timeframe_group_id equals from_timeframe_group_id, (2) the set of days identified by service_id contains the current day of the fare leg's start time, and (3) the time-of-day of the fare leg's start time is greater than or equal to timeframes.start_time and less than timeframes.end_time. An empty from_timeframe_group_id indicates that the start time of the leg does not affect the matching of this rule. When matching against an effective fare leg of multiple legs, the first leg is used for determining the starting fare validation event."]
to_timeframe_group_id string [pk, note: "Defines the timeframe for the fare validation event at the end of the fare leg. The end time is computed in local time as determined by the Local Time Semantics of timeframes.txt, using the stop or station of the fare leg's arrival event for timezone resolution when appropriate. For a fare leg rule that specifies a to_timeframe_group_id, the rule matches a leg if there exists a record in timeframes.txt where: (1) timeframe_group_id equals to_timeframe_group_id, (2) the set of days identified by service_id contains the current day of the fare leg's end time, and (3) the time-of-day of the fare leg's end time is greater than or equal to timeframes.start_time and less than timeframes.end_time. An empty to_timeframe_group_id indicates that the end time of the leg does not affect the matching of this rule. When matching against an effective fare leg of multiple legs, the last leg is used for determining the ending fare validation event."]
fare_product_id string [not null, pk, note: "The fare product required to travel the leg."]
rule_priority int [note: "Defines the order of priority in which matching rules are applied to legs, allowing certain rules to take precedence over others. When multiple entries match, the rule or set of rules with the highest value for rule_priority will be selected. An empty value for rule_priority is treated as zero."]
Note: 'Fare rules for individual legs of travel.'
}

Table gtfs.fare_leg_join_rules {
from_network_id string [not null, pk, note: "Matches a pre-transfer leg that uses the specified route network. If specified, the same to_network_id must also be specified."]
to_network_id string [not null, pk, note: "Matches a post-transfer leg that uses the specified route network. If specified, the same from_network_id must also be specified."]
from_stop_id string [pk, note: "Matches a pre-transfer leg that ends at the specified stop (location_type=0 or empty) or station (location_type=1)."]
to_stop_id string [pk, note: "Matches a post-transfer leg that starts at the specified stop (location_type=0 or empty) or station (location_type=1)."]
Note: 'Rules for defining two or more legs should be considered as a single effective fare leg for the purposes of matching against rules in fare_leg_rules.txt'
}

Table gtfs.fare_transfer_rules {
from_leg_group_id string [pk, note: "Identifies a group of pre-transfer fare leg rules. If there are no matching from_leg_group_id values to the leg_group_id being filtered, empty from_leg_group_id entries will be matched by default and correspond to all leg groups defined under fare_leg_rules.leg_group_id excluding the ones listed under fare_transfer_rules.from_leg_group_id."]
to_leg_group_id string [pk, note: "Identifies a group of post-transfer fare leg rules. If there are no matching to_leg_group_id values to the leg_group_id being filtered, empty to_leg_group_id entries will be matched by default and correspond to all leg groups defined under fare_leg_rules.leg_group_id excluding the ones listed under fare_transfer_rules.to_leg_group_id."]
transfer_count int [pk, note: "Defines how many consecutive transfers the transfer rule may be applied to. Valid options are -1 (no limit) or 1 or more (defines how many transfers the rule may span). If a sub-journey matches multiple records with different transfer_count values, the rule with the minimum transfer_count that is greater than or equal to the current transfer count of the sub-journey is selected."]
duration_limit int [pk, note: "Defines the duration limit of the transfer, expressed in integer increments of seconds. If there is no duration limit, duration_limit must be empty."]
duration_limit_type gtfs.fare_transfer_rules_duration_limit_type_options [note: "Defines the relative start and end of duration_limit. When a transfer rule with the same from_leg_group_id and to_leg_group_id is matched multiple times consecutively within a multi-leg journey, the duration_limit specified by the rule should be measured starting from the first matched leg."]
fare_transfer_type gtfs.fare_transfer_rules_fare_transfer_type_options [not null, note: "Indicates the cost processing method of transferring between legs in a journey."]
fare_product_id string [pk, note: "The fare product required to transfer between two fare legs. If empty, the cost of the transfer rule is 0."]
Note: 'Fare rules for transfers between legs of travel.'
}

Table gtfs.areas {
area_id string [not null, pk, note: "Identifies an area. Must be unique in areas.txt."]
area_name string [note: "The name of the area as displayed to the rider."]
Note: 'Area grouping of locations.'
}

Table gtfs.stop_areas {
area_id string [not null, note: "Identifies an area to which one or multiple stop_id values belong. The same stop_id may be defined in many area_id values."]
stop_id string [not null, note: "Identifies a stop. If a station (location_type=1) is defined in this field, all of its platforms are part of the same area unless platforms are assigned to other areas."]
Note: 'Rules to assign stops to areas.'
}

Table gtfs.networks {
network_id string [not null, pk, note: "Identifies a network. Must be unique in networks.txt."]
network_name string [note: "The name of the network that applies for fare leg rules, as used by the local agency and its riders."]
Note: 'Network grouping of routes.'
}

Table gtfs.route_networks {
network_id string [not null, note: "Identifies a network to which one or multiple route_id values belong. A route_id can only be defined in one network_id."]
route_id string [not null, pk, note: "Identifies a route."]
Note: 'Rules to assign routes to networks.'
}

Table gtfs.frequencies {
trip_id string [not null, pk, note: "Identifies a trip to which the specified headway of service applies."]
start_time time [not null, pk, note: "Time at which the first vehicle departs from the first stop of the trip with the specified headway."]
end_time time [not null, note: "Time at which service changes to a different headway (or ceases) at the first stop in the trip."]
headway_secs int [not null, note: "Time, in seconds, between departures from the same stop for the trip, during the time interval specified by start_time and end_time. Multiple headways may be defined for the same trip, but must not overlap. New headways may start at the exact time the previous headway ends."]
exact_times gtfs.frequencies_exact_times_options [note: "Indicates the type of service for a trip."]
Note: 'Headway (time between trips) for headway-based service or a compressed representation of fixed-schedule service.'
}

Table gtfs.transfers {
from_stop_id string [pk, note: "Identifies a stop (location_type=0) or a station (location_type=1) where a connection between routes begins. If this field refers to a station, the transfer rule applies to all its child stops. It must refer to a stop (location_type=0) if transfer_type is 4 or 5."]
to_stop_id string [pk, note: "Identifies a stop (location_type=0) or a station (location_type=1) where a connection between routes ends. If this field refers to a station, the transfer rule applies to all its child stops. It must refer to a stop (location_type=0) if transfer_type is 4 or 5."]
from_route_id string [pk, note: "Identifies a route where a connection begins. If from_route_id is defined, the transfer will apply to the arriving trip on the route for the given from_stop_id. If both from_trip_id and from_route_id are defined, the trip_id must belong to the route_id, and from_trip_id will take precedence."]
to_route_id string [pk, note: "Identifies a route where a connection ends. If to_route_id is defined, the transfer will apply to the departing trip on the route for the given to_stop_id. If both to_trip_id and to_route_id are defined, the trip_id must belong to the route_id, and to_trip_id will take precedence."]
from_trip_id string [pk, note: "Identifies a trip where a connection between routes begins. If from_trip_id is defined, the transfer will apply to the arriving trip for the given from_stop_id. If both from_trip_id and from_route_id are defined, the trip_id must belong to the route_id, and from_trip_id will take precedence."]
to_trip_id string [pk, note: "Identifies a trip where a connection between routes ends. If to_trip_id is defined, the transfer will apply to the departing trip for the given to_stop_id. If both to_trip_id and to_route_id are defined, the trip_id must belong to the route_id, and to_trip_id will take precedence."]
transfer_type gtfs.transfers_transfer_type_options [not null, note: "Indicates the type of connection for the specified (from_stop_id, to_stop_id) pair."]
min_transfer_time int [note: "Amount of time, in seconds, that must be available to permit a transfer between routes at the specified stops."]
Note: 'Rules for making connections at transfer points between routes.'
}

Table gtfs.pathways {
pathway_id string [not null, pk, note: "Identifies a pathway. Must be unique in the dataset. Different pathways may have the same from_stop_id and to_stop_id values. Example: Two escalators side-by-side in opposite directions, or a stair set and elevator going from the same place to the same place."]
from_stop_id string [not null, note: "Location at which the pathway begins. Must identify a platform (location_type=0 or empty), entrance/exit (location_type=2), generic node (location_type=3) or boarding area (location_type=4). Values that identify stations (location_type=1), or stops with stop_access=1, are forbidden."]
to_stop_id string [not null, note: "Location at which the pathway ends. Must identify a platform (location_type=0 or empty), entrance/exit (location_type=2), generic node (location_type=3) or boarding area (location_type=4). Values that identify stations (location_type=1), or stops with stop_access=1, are forbidden."]
pathway_mode gtfs.pathways_pathway_mode_options [not null, note: "Type of pathway between the specified (from_stop_id, to_stop_id) pair."]
is_bidirectional gtfs.pathways_is_bidirectional_options [not null, note: "Indicates the direction that the pathway can be taken."]
length float [note: "Horizontal length in meters of the pathway from the origin location to the destination location. Recommended for walkways (pathway_mode=1), fare gates (pathway_mode=6) and exit gates (pathway_mode=7)."]
traversal_time int [note: "Average time in seconds needed to walk through the pathway from the origin location to the destination location. Recommended for moving sidewalks (pathway_mode=3), escalators (pathway_mode=4) and elevators (pathway_mode=5)."]
stair_count string [note: "Number of stairs of the pathway. A positive value implies walking up; a negative value implies walking down. Recommended for stairs (pathway_mode=2). If only an estimated stair count can be provided, approximate 15 stairs for 1 floor."]
max_slope float [note: "Maximum slope ratio of the pathway. Valid options are 0 or empty for no slope, or a float ratio (positive for upwards, negative for downwards). Should only be used with walkways (pathway_mode=1) and moving sidewalks (pathway_mode=3). Example: 0.083 (8.3%) is the maximum slope ratio for hand-propelled wheelchairs in the US."]
min_width float [note: "Minimum width of the pathway in meters. Recommended if the minimum width is less than 1 meter."]
signposted_as string [note: "Public facing text from physical signage that is visible to riders. The text should appear exactly how it is printed on the signs. May be used to provide text directions to riders, such as \"follow signs to\". When the physical signage is multilingual, this field may be populated and translated following the example of stops.stop_name in feed_info.feed_lang."]
reversed_signposted_as string [note: "Same as signposted_as, but when the pathway is used from the to_stop_id to the from_stop_id."]
Note: 'Pathways linking together locations within stations.'
}

Table gtfs.levels {
level_id string [not null, pk, note: "Identifies a level in a station."]
level_index float [not null, note: "Numeric index of the level that indicates its relative position. Ground level should have index 0, with levels above ground indicated by positive indices and levels below ground by negative indices."]
level_name string [note: "Name of the level as seen by the rider inside the building or station. Example: Take the elevator to \"Mezzanine\" or \"Platform\" or \"-1\"."]
Note: 'Levels within stations.'
}

Table gtfs.location_groups {
location_group_id string [not null, pk, note: "Identifies a location group. ID must be unique across all stops.stop_id, locations.geojson id, and location_groups.location_group_id values."]
location_group_name string [note: "The name of the location group as displayed to the rider."]
Note: 'A group of stops that together indicate locations where a rider may request pickup or drop off.'
}

Table gtfs.location_group_stops {
location_group_id string [not null, note: "Identifies a location group to which one or multiple stop_id values belong. The same stop_id may be defined in many location_group_id values."]
stop_id string [not null, note: "Identifies a stop belonging to the location group."]
Note: 'Rules to assign stops to location groups.'
}

Table gtfs.locations {
type string [not null, note: "\"FeatureCollection\" of locations."]
features string [not null, note: "Collection of \"Feature\" objects describing the locations."]
Note: 'Zones for rider pickup or drop-off requests by on-demand services, represented as GeoJSON polygons.'
}

Table gtfs.booking_rules {
booking_rule_id string [not null, pk, note: "Identifies a rule."]
booking_type gtfs.booking_rules_booking_type_options [not null, note: "Indicates how far in advance booking can be made."]
prior_notice_duration_min int [note: "Minimum number of minutes before travel to make the request."]
prior_notice_duration_max int [note: "Maximum number of minutes before travel to make the booking request."]
prior_notice_last_day int [note: "Last day before travel to make the booking request. Example: Ride must be booked 1 day in advance before 5PM will be encoded as prior_notice_last_day=1."]
prior_notice_last_time time [note: "Last time on the last day before travel to make the booking request. Example: Ride must be booked 1 day in advance before 5PM will be encoded as prior_notice_last_time=17:00:00."]
prior_notice_start_day int [note: "Earliest day before travel to make the booking request. Example: Ride can be booked at the earliest one week in advance at midnight will be encoded as prior_notice_start_day=7."]
prior_notice_start_time time [note: "Earliest time on the earliest day before travel to make the booking request. Example: Ride can be booked at the earliest one week in advance at midnight will be encoded as prior_notice_start_time=00:00:00."]
prior_notice_service_id string [note: "Indicates the service days on which prior_notice_last_day or prior_notice_start_day are counted. Example: If empty, prior_notice_start_day=2 will be two calendar days in advance. If defined as a service_id containing only business days, prior_notice_start_day=2 will be two business days in advance."]
message string [note: "Message to riders utilizing service at a stop_time when booking on-demand pickup and drop off."]
pickup_message string [note: "Functions in the same way as message but used when riders have on-demand pickup only."]
drop_off_message string [note: "Functions in the same way as message but used when riders have on-demand drop off only."]
phone_number string [note: "Phone number to call to make the booking request."]
info_url string [note: "URL providing information about the booking rule."]
booking_url string [note: "URL to an online interface or app where the booking request can be made."]
Note: 'Booking information for rider-requested services.'
}

Table gtfs.translations {
table_name gtfs.translations_table_name_options [not null, pk, note: "Defines the table that contains the field to be translated. Any file added to GTFS will have a table_name value equivalent to the file name, not including the .txt file extension."]
field_name string [not null, pk, note: "Name of the field to be translated. Fields with type Text may be translated; URL, Email, and Phone number may be translated to provide resources in the correct language. Other types should not be translated."]
language string [not null, pk, note: "Language of translation. If the language is the same as in feed_info.feed_lang, the original value of the field is assumed to be the default value to use in languages without specific translations (if default_lang does not specify otherwise)."]
translation string [not null, note: "Translated value."]
record_id string [pk, note: "Defines the record that corresponds to the field to be translated. The value must be the first or only field of a table's primary key as defined in the reference."]
record_sub_id string [pk, note: "Secondary ID of the table when the table does not have a unique ID, as defined in the reference."]
field_value string [pk, note: "Defines the value which should be translated instead of identifying a specific record. The translation is applied when the field identified by table_name and field_name contains the exact same value defined in field_value. If only a subset of the value matches field_value, the translation is not applied. If two translation rules match the same record (one with field_value and one with record_id), the rule with record_id takes precedence."]
Note: 'Translations of customer-facing dataset values.'
}

Table gtfs.feed_info {
feed_publisher_name string [not null, note: "Full name of the organization that publishes the dataset."]
feed_publisher_url string [not null, note: "URL of the dataset publishing organization's website."]
feed_lang string [not null, note: "Default language used for the text in this dataset. The translations.txt file can be used if the text needs to be translated into languages other than the default one. The default language may be multilingual for datasets with the original text in multiple languages; in such cases, feed_lang should contain mul and translations should be provided for each language used in the dataset. If all original text is in the same language, then mul should not be used."]
default_lang string [note: "Defines the language that should be used when the data consumer does not know the language of the rider."]
feed_start_date date [note: "The dataset provides complete and reliable schedule information for service in the period from the beginning of the feed_start_date day to the end of the feed_end_date day. Both days may be left empty if unavailable. The feed_end_date date must not precede the feed_start_date date if both are given. It is recommended that dataset providers give schedule data outside this period to advise of likely future service, but dataset consumers should treat it mindful of its non-authoritative status. If feed_start_date or feed_end_date extend beyond the active calendar dates defined in calendar.txt and calendar_dates.txt, the dataset asserts there is no service for dates within the feed range but not included in the active calendar dates."]
feed_end_date date [note: "End date for the feed period described by feed_start_date."]
feed_version string [note: "String that indicates the current version of the GTFS dataset."]
feed_contact_email string [note: "Email address for communication regarding the GTFS dataset and data publishing practices. feed_contact_email is a technical contact for GTFS-consuming applications. Provide customer service contact information through agency.txt. It is recommended that at least one of feed_contact_email or feed_contact_url are provided."]
feed_contact_url string [note: "URL for contact information regarding the GTFS dataset and data publishing practices. feed_contact_url is a technical contact for GTFS-consuming applications. Provide customer service contact information through agency.txt. It is recommended that at least one of feed_contact_url or feed_contact_email are provided."]
Note: 'Dataset metadata, including publisher, version, and expiration information.'
}

Table gtfs.attributions {
attribution_id string [pk, note: "Identifies an attribution for the dataset or a subset of it."]
agency_id string [note: "Agency to which the attribution applies. If one agency_id, route_id, or trip_id attribution is defined, the other ones must be empty. If none is specified, the attribution applies to the whole dataset."]
route_id string [note: "Functions in the same way as agency_id except the attribution applies to a route."]
trip_id string [note: "Functions in the same way as agency_id except the attribution applies to a trip."]
organization_name string [not null, note: "Name of the organization that the dataset is attributed to."]
is_producer gtfs.attributions_is_producer_options [note: "The role of the organization is producer. At least one of is_producer, is_operator, or is_authority should be set to 1."]
is_operator gtfs.attributions_is_operator_options [note: "Functions in the same way as is_producer except the role of the organization is operator."]
is_authority gtfs.attributions_is_authority_options [note: "Functions in the same way as is_producer except the role of the organization is authority."]
attribution_url string [note: "URL of the organization."]
attribution_email string [note: "Email of the organization."]
attribution_phone string [note: "Phone number of the organization."]
Note: 'Dataset attributions.'
}

