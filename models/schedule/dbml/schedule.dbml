 "0" [note: 'None. Used when there is no fare media involved in purchasing or validating a fare product, such as paying cash to a driver or conductor with no physical ticket provided.']
 "1" [note: 'Physical paper ticket that allows a passenger to take either a certain number of pre-purchased trips or unlimited trips within a fixed period of time.']
 "2" [note: 'Physical transit card that has stored tickets, passes or monetary value.']
 "3" [note: 'cEMV (contactless Europay, Mastercard and Visa) as an open-loop token container for account-based ticketing.']
 "4" [note: 'Mobile app that has stored virtual transit cards, tickets, passes, or monetary value.']
}

enum gtfs.fare_transfer_rules_duration_limit_type_options {
 "0" [note: 'Between the departure fare validation of the first leg in transfer sub-journey and the arrival fare validation of the last leg in transfer sub-journey.']
 "1" [note: 'Between the departure fare validation of the first leg in transfer sub-journey and the departure fare validation of the last leg in transfer sub-journey.']
 "2" [note: 'Between the arrival fare validation of the first leg in transfer sub-journey and the departure fare validation of the last leg in transfer sub-journey.']
 "3" [note: 'Between the arrival fare validation of the first leg in transfer sub-journey and the arrival fare validation of the last leg in transfer sub-journey.']
}

enum gtfs.fare_transfer_rules_fare_transfer_type_options {
 "0" [note: 'From-leg fare_leg_rules.fare_product_id plus fare_transfer_rules.fare_product_id; A + AB.']
 "1" [note: 'From-leg fare_leg_rules.fare_product_id plus fare_transfer_rules.fare_product_id plus to-leg fare_leg_rules.fare_product_id; A + AB + B.']
 "2" [note: 'fare_transfer_rules.fare_product_id; AB.']
}

enum gtfs.frequencies_exact_times_options {
 "0 or empty" [note: 'Frequency-based trips.']
 "1" [note: 'Schedule-based trips with the exact same headway throughout the day. end_time must be greater than the last desired trip start_time but less than the last desired trip start_time + headway_secs.']
}

enum gtfs.transfers_transfer_type_options {
 "0 or empty" [note: 'Recommended transfer point between routes.']
 "1" [note: 'Timed transfer point between two routes.']
 "2" [note: 'Transfer requires a minimum amount of time between arrival and departure to ensure a connection. The time required to transfer is specified by min_transfer_time.']
 "3" [note: 'Transfers are not possible between routes at the location.']
 "4" [note: 'Passengers can transfer from one trip to another by staying onboard the same vehicle (in-seat transfer).']
 "5" [note: 'In-seat transfers are not allowed between sequential trips. The passenger must alight from the vehicle and re-board.']
}

enum gtfs.pathways_pathway_mode_options {
 "1" [note: 'Walkway.']
 "2" [note: 'Stairs.']
 "3" [note: 'Moving sidewalk/travelator.']
 "4" [note: 'Escalator.']
 "5" [note: 'Elevator.']
 "6" [note: 'Fare gate (or payment gate): A pathway that crosses into an area of the station where proof of payment is required. Fare gates may separate paid areas of the station from unpaid ones, or separate different payment areas within the same station from each other.']
 "7" [note: 'Exit gate: A pathway exiting a paid area into an unpaid area where proof of payment is not required to cross.']
}

enum gtfs.pathways_is_bidirectional_options {
 "0" [note: 'Unidirectional pathway that can only be used from from_stop_id to to_stop_id.']
 "1" [note: 'Bidirectional pathway that can be used in both directions. Exit gates (pathway_mode=7) must not be bidirectional.']
}

enum gtfs.booking_rules_booking_type_options {
