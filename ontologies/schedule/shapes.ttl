# stop_times.txt
# ==========

gtfs:StopTimeShape a sh:NodeShape ;
    sh:targetClass gtfs:StopTime ;
    # trip_id (Required)
    sh:property [
        sh:path gtfs:trip_id ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] ;

    # arrival_time (Conditionally Required)
    sh:property [
        sh:path gtfs:arrival_time ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{1,3}:[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required for the first and last stop in a trip (defined by stop_times.stop_sequence). Required for timepoint=1. Forbidden when start_pickup_drop_off_window or end_pickup_drop_off_window are defined. Optional otherwise."""
    ] ;

    sh:description """Dataset-scoped rule (not enforced in SHACL core, phase 2): arrival_time required when: First and last stop of a trip (defined by stop_times.stop_sequence).""" ;

    # rule: arrival_time: required when timepoint in [1]
    sh:or (
        [ sh:property [ sh:path gtfs:timepoint ; sh:not [ sh:in ( 1 ) ] ] ]
        [ sh:property [ sh:path gtfs:arrival_time ; sh:minCount 1 ] ]
    ) ;

    # rule: arrival_time: forbidden when start_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:arrival_time ; sh:maxCount 0 ] ]
    ) ;

    # rule: arrival_time: forbidden when end_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:arrival_time ; sh:maxCount 0 ] ]
    ) ;

    # departure_time (Conditionally Required)
    sh:property [
        sh:path gtfs:departure_time ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{1,3}:[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required for timepoint=1. Forbidden when start_pickup_drop_off_window or end_pickup_drop_off_window are defined. Optional otherwise."""
    ] ;

    # rule: departure_time: required when timepoint in [1]
    sh:or (
        [ sh:property [ sh:path gtfs:timepoint ; sh:not [ sh:in ( 1 ) ] ] ]
        [ sh:property [ sh:path gtfs:departure_time ; sh:minCount 1 ] ]
    ) ;

    # rule: departure_time: forbidden when start_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:departure_time ; sh:maxCount 0 ] ]
    ) ;

    # rule: departure_time: forbidden when end_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:departure_time ; sh:maxCount 0 ] ]
    ) ;

    # stop_id (Conditionally Required)
    sh:property [
        sh:path gtfs:stop_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Required if stop_times.location_group_id AND stop_times.location_id are NOT defined. Forbidden if stop_times.location_group_id or stop_times.location_id are defined."""
    ] ;

    # rule: stop_id: required when location_group_id is empty and location_id is empty
    sh:or (
        [ sh:property [ sh:path gtfs:location_group_id ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:location_id ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:stop_id ; sh:minCount 1 ] ]
    ) ;

    # rule: stop_id: forbidden when location_group_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_group_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:stop_id ; sh:maxCount 0 ] ]
    ) ;

    # rule: stop_id: forbidden when location_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:stop_id ; sh:maxCount 0 ] ]
    ) ;

    # location_group_id (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:location_group_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Forbidden. Forbidden if stop_times.stop_id or stop_times.location_id are defined."""
    ] ;

    # rule: location_group_id: forbidden when stop_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:stop_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:location_group_id ; sh:maxCount 0 ] ]
    ) ;

    # rule: location_group_id: forbidden when location_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:location_group_id ; sh:maxCount 0 ] ]
    ) ;

    # location_id (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:location_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Forbidden. Forbidden if stop_times.stop_id or stop_times.location_group_id are defined."""
    ] ;

    # rule: location_id: forbidden when stop_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:stop_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:location_id ; sh:maxCount 0 ] ]
    ) ;

    # rule: location_id: forbidden when location_group_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_group_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:location_id ; sh:maxCount 0 ] ]
    ) ;

    # stop_sequence (Required)
    sh:property [
        sh:path gtfs:stop_sequence ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:description """Required"""
    ] ;

    # stop_headsign (Optional)
    sh:property [
        sh:path gtfs:stop_headsign ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # start_pickup_drop_off_window (Conditionally Required)
    sh:property [
        sh:path gtfs:start_pickup_drop_off_window ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{1,3}:[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required if stop_times.location_group_id or stop_times.location_id is defined. Required if end_pickup_drop_off_window is defined. Forbidden if arrival_time or departure_time is defined. Optional otherwise."""
    ] ;

    # rule: start_pickup_drop_off_window: required when location_group_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_group_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:minCount 1 ] ]
    ) ;

    # rule: start_pickup_drop_off_window: required when location_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:minCount 1 ] ]
    ) ;

    # rule: start_pickup_drop_off_window: required when end_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:minCount 1 ] ]
    ) ;

    # rule: start_pickup_drop_off_window: forbidden when arrival_time is defined
    sh:or (
        [ sh:property [ sh:path gtfs:arrival_time ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
    ) ;

    # rule: start_pickup_drop_off_window: forbidden when departure_time is defined
    sh:or (
        [ sh:property [ sh:path gtfs:departure_time ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
    ) ;

    # end_pickup_drop_off_window (Conditionally Required)
    sh:property [
        sh:path gtfs:end_pickup_drop_off_window ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{1,3}:[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required if stop_times.location_group_id or stop_times.location_id is defined. Required if start_pickup_drop_off_window is defined. Forbidden if arrival_time or departure_time is defined. Optional otherwise."""
    ] ;

    # rule: end_pickup_drop_off_window: required when location_group_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_group_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:minCount 1 ] ]
    ) ;

    # rule: end_pickup_drop_off_window: required when location_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:location_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:minCount 1 ] ]
    ) ;

    # rule: end_pickup_drop_off_window: required when start_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:minCount 1 ] ]
    ) ;

    # rule: end_pickup_drop_off_window: forbidden when arrival_time is defined
    sh:or (
        [ sh:property [ sh:path gtfs:arrival_time ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
    ) ;

    # rule: end_pickup_drop_off_window: forbidden when departure_time is defined
    sh:or (
        [ sh:property [ sh:path gtfs:departure_time ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
    ) ;

    # pickup_type (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:pickup_type ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 3 ) ;
        sh:description """Conditionally Forbidden. pickup_type=0 forbidden if start_pickup_drop_off_window or end_pickup_drop_off_window are defined. pickup_type=3 forbidden if start_pickup_drop_off_window or end_pickup_drop_off_window are defined. Optional otherwise."""
    ] ;

    # rule: pickup_type: forbidden when start_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:pickup_type ; sh:not [ sh:in ( 0 3 ) ] ] ]
    ) ;

    # rule: pickup_type: forbidden when end_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:pickup_type ; sh:not [ sh:in ( 0 3 ) ] ] ]
    ) ;

    # drop_off_type (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:drop_off_type ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 3 ) ;
        sh:description """Conditionally Forbidden. drop_off_type=0 forbidden if start_pickup_drop_off_window or end_pickup_drop_off_window are defined. Optional otherwise."""
    ] ;

    # rule: drop_off_type: forbidden when start_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:drop_off_type ; sh:not [ sh:in ( 0 ) ] ] ]
    ) ;

    # rule: drop_off_type: forbidden when end_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:drop_off_type ; sh:not [ sh:in ( 0 ) ] ] ]
    ) ;

    # continuous_pickup (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:continuous_pickup ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 3 ) ;
        sh:description """Conditionally Forbidden. Any value other than 1 or empty is Forbidden if start_pickup_drop_off_window or end_pickup_drop_off_window are defined. Optional otherwise."""
    ] ;

    # rule: continuous_pickup: forbidden when start_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:continuous_pickup ; sh:in ( 1 ) ] ]
    ) ;

    # rule: continuous_pickup: forbidden when end_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:continuous_pickup ; sh:in ( 1 ) ] ]
    ) ;

    # continuous_drop_off (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:continuous_drop_off ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 3 ) ;
        sh:description """Conditionally Forbidden. Any value other than 1 or empty is Forbidden if start_pickup_drop_off_window or end_pickup_drop_off_window are defined. Optional otherwise."""
    ] ;

    # rule: continuous_drop_off: forbidden when start_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:continuous_drop_off ; sh:in ( 1 ) ] ]
    ) ;

    # rule: continuous_drop_off: forbidden when end_pickup_drop_off_window is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_pickup_drop_off_window ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:continuous_drop_off ; sh:in ( 1 ) ] ]
    ) ;

    # shape_dist_traveled (Optional)
    sh:property [
        sh:path gtfs:shape_dist_traveled ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.0 ;
        sh:description """Optional"""
    ] ;

    # timepoint (Optional)
    sh:property [
        sh:path gtfs:timepoint ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 ) ;
        sh:description """Optional"""
    ] ;

    # pickup_booking_rule_id (Optional)
    sh:property [
        sh:path gtfs:pickup_booking_rule_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # drop_off_booking_rule_id (Optional)
    sh:property [
        sh:path gtfs:drop_off_booking_rule_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] .

