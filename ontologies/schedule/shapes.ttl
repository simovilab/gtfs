# ==========
# timeframes.txt
# ==========

gtfs:TimeframeShape a sh:NodeShape ;
    sh:targetClass gtfs:Timeframe ;
    # timeframe_group_id (Required)
    sh:property [
        sh:path gtfs:timeframe_group_id ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] ;

    # start_time (Conditionally Required)
    sh:property [
        sh:path gtfs:start_time ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([01]?\\d|2[0-3]):[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required if timeframes.end_time is defined. Forbidden otherwise."""
    ] ;

    # rule: start_time: required when end_time is defined
    sh:or (
        [ sh:property [ sh:path gtfs:end_time ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:start_time ; sh:minCount 1 ] ]
    ) ;

    # rule: start_time: forbidden when end_time is empty
    sh:or (
        [ sh:property [ sh:path gtfs:end_time ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:start_time ; sh:maxCount 0 ] ]
    ) ;

    # end_time (Conditionally Required)
    sh:property [
        sh:path gtfs:end_time ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^([01]?\\d|2[0-3]):[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required if timeframes.start_time is defined. Forbidden otherwise."""
    ] ;

    # rule: end_time: required when start_time is defined
    sh:or (
        [ sh:property [ sh:path gtfs:start_time ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:end_time ; sh:minCount 1 ] ]
    ) ;

    # rule: end_time: forbidden when start_time is empty
    sh:or (
        [ sh:property [ sh:path gtfs:start_time ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:end_time ; sh:maxCount 0 ] ]
    ) ;

    # service_id (Required)
    sh:property [
        sh:path gtfs:service_id ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] .

