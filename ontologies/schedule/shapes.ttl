        sh:description """Required"""
    ] ;

    # rule_priority (Optional)
    sh:property [
        sh:path gtfs:rule_priority ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:description """Optional"""
    ] .

# ==========
# fare_leg_join_rules.txt
# ==========

gtfs:FareLegJoinRuleShape a sh:NodeShape ;
    sh:targetClass gtfs:FareLegJoinRule ;
    # from_network_id (Required)
    sh:property [
        sh:path gtfs:from_network_id ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] ;

    # to_network_id (Required)
    sh:property [
        sh:path gtfs:to_network_id ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] ;

    # from_stop_id (Conditionally Required)
    sh:property [
        sh:path gtfs:from_stop_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Required if to_stop_id is defined. Optional otherwise."""
    ] ;

    # rule: from_stop_id: required when to_stop_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:to_stop_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:from_stop_id ; sh:minCount 1 ] ]
    ) ;

    # to_stop_id (Conditionally Required)
    sh:property [
        sh:path gtfs:to_stop_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Required if from_stop_id is defined. Optional otherwise."""
    ] ;

    # rule: to_stop_id: required when from_stop_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:from_stop_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:to_stop_id ; sh:minCount 1 ] ]
    ) .

# ==========
# fare_transfer_rules.txt
# ==========

gtfs:FareTransferRuleShape a sh:NodeShape ;
    sh:targetClass gtfs:FareTransferRule ;
    # from_leg_group_id (Optional)
    sh:property [
        sh:path gtfs:from_leg_group_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # to_leg_group_id (Optional)
    sh:property [
        sh:path gtfs:to_leg_group_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # transfer_count (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:transfer_count ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:not [ sh:hasValue 0 ] ;
        sh:description """Conditionally Forbidden. Forbidden if fare_transfer_rules.from_leg_group_id does not equal fare_transfer_rules.to_leg_group_id. Required if fare_transfer_rules.from_leg_group_id equals fare_transfer_rules.to_leg_group_id."""
    ] ;

    # rule: transfer_count: forbidden when from_leg_group_id != to_leg_group_id
    sh:or (
        [ sh:property [ sh:path gtfs:from_leg_group_id ; sh:equals gtfs:to_leg_group_id ] ]
        [ sh:property [ sh:path gtfs:transfer_count ; sh:maxCount 0 ] ]
    ) ;

    # rule: transfer_count: required when from_leg_group_id = to_leg_group_id
    sh:or (
        [ sh:property [ sh:path gtfs:from_leg_group_id ; sh:disjoint gtfs:to_leg_group_id ] ]
        [ sh:property [ sh:path gtfs:transfer_count ; sh:minCount 1 ] ]
    ) ;

    # duration_limit (Optional)
    sh:property [
        sh:path gtfs:duration_limit ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minExclusive 0 ;
        sh:description """Optional"""
    ] ;

    # duration_limit_type (Conditionally Required)
    sh:property [
        sh:path gtfs:duration_limit_type ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 3 ) ;
        sh:description """Conditionally Required. Required if fare_transfer_rules.duration_limit is defined. Forbidden if fare_transfer_rules.duration_limit is empty."""
    ] ;

    # rule: duration_limit_type: required when duration_limit is defined
    sh:or (
        [ sh:property [ sh:path gtfs:duration_limit ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:duration_limit_type ; sh:minCount 1 ] ]
    ) ;

    # rule: duration_limit_type: forbidden when duration_limit is empty
    sh:or (
        [ sh:property [ sh:path gtfs:duration_limit ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:duration_limit_type ; sh:maxCount 0 ] ]
    ) ;

    # fare_transfer_type (Required)
    sh:property [
        sh:path gtfs:fare_transfer_type ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 ) ;
        sh:description """Required"""
    ] ;

    # fare_product_id (Optional)
    sh:property [
        sh:path gtfs:fare_product_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] .

