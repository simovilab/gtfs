# ==========
# booking_rules.txt
# ==========

gtfs:BookingRuleShape a sh:NodeShape ;
    sh:targetClass gtfs:BookingRule ;
    # booking_rule_id (Required)
    sh:property [
        sh:path gtfs:booking_rule_id ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] ;

    # booking_type (Required)
    sh:property [
        sh:path gtfs:booking_type ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 ) ;
        sh:description """Required"""
    ] ;

    # prior_notice_duration_min (Conditionally Required)
    sh:property [
        sh:path gtfs:prior_notice_duration_min ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:description """Conditionally Required. Required for booking_type=1. Forbidden otherwise."""
    ] ;

    # rule: prior_notice_duration_min: required when booking_type in [1]
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 1 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_duration_min ; sh:minCount 1 ] ]
    ) ;

    # rule: prior_notice_duration_min: forbidden when booking_type in [0, 2]
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 0 2 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_duration_min ; sh:maxCount 0 ] ]
    ) ;

    # prior_notice_duration_max (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:prior_notice_duration_max ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:description """Conditionally Forbidden. Forbidden for booking_type=0 and booking_type=2. Optional for booking_type=1."""
    ] ;

    # rule: prior_notice_duration_max: forbidden when booking_type in [0, 2]
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 0 2 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_duration_max ; sh:maxCount 0 ] ]
    ) ;

    # prior_notice_last_day (Conditionally Required)
    sh:property [
        sh:path gtfs:prior_notice_last_day ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:description """Conditionally Required. Required for booking_type=2. Forbidden otherwise."""
    ] ;

    # rule: prior_notice_last_day: required when booking_type in [2]
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 2 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_last_day ; sh:minCount 1 ] ]
    ) ;

    # rule: prior_notice_last_day: forbidden when booking_type in [0, 1]
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 0 1 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_last_day ; sh:maxCount 0 ] ]
    ) ;

    # prior_notice_last_time (Conditionally Required)
    sh:property [
        sh:path gtfs:prior_notice_last_time ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{1,3}:[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required if prior_notice_last_day is defined. Forbidden otherwise."""
    ] ;

    # rule: prior_notice_last_time: required when prior_notice_last_day is defined
    sh:or (
        [ sh:property [ sh:path gtfs:prior_notice_last_day ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:prior_notice_last_time ; sh:minCount 1 ] ]
    ) ;

    # rule: prior_notice_last_time: forbidden when prior_notice_last_day is empty
    sh:or (
        [ sh:property [ sh:path gtfs:prior_notice_last_day ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:prior_notice_last_time ; sh:maxCount 0 ] ]
    ) ;

    # prior_notice_start_day (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:prior_notice_start_day ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:description """Conditionally Forbidden. Forbidden for booking_type=0. Forbidden for booking_type=1 if prior_notice_duration_max is defined. Optional otherwise."""
    ] ;

    # rule: prior_notice_start_day: forbidden when booking_type in [0]
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 0 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_start_day ; sh:maxCount 0 ] ]
    ) ;

    # rule: prior_notice_start_day: forbidden when booking_type in [1] and prior_notice_duration_max is defined
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 1 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_duration_max ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:prior_notice_start_day ; sh:maxCount 0 ] ]
    ) ;

    # prior_notice_start_time (Conditionally Required)
    sh:property [
        sh:path gtfs:prior_notice_start_time ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{1,3}:[0-5]\\d:[0-5]\\d$" ;
        sh:description """Conditionally Required. Required if prior_notice_start_day is defined. Forbidden otherwise."""
    ] ;

    # rule: prior_notice_start_time: required when prior_notice_start_day is defined
    sh:or (
        [ sh:property [ sh:path gtfs:prior_notice_start_day ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:prior_notice_start_time ; sh:minCount 1 ] ]
    ) ;

    # rule: prior_notice_start_time: forbidden when prior_notice_start_day is empty
    sh:or (
        [ sh:property [ sh:path gtfs:prior_notice_start_day ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:prior_notice_start_time ; sh:maxCount 0 ] ]
    ) ;

    # prior_notice_service_id (Conditionally Forbidden)
    sh:property [
        sh:path gtfs:prior_notice_service_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Forbidden. Optional if booking_type=2. Forbidden otherwise."""
    ] ;

    # rule: prior_notice_service_id: forbidden when booking_type in [0, 1]
    sh:or (
        [ sh:property [ sh:path gtfs:booking_type ; sh:not [ sh:in ( 0 1 ) ] ] ]
        [ sh:property [ sh:path gtfs:prior_notice_service_id ; sh:maxCount 0 ] ]
    ) ;

    # message (Optional)
    sh:property [
        sh:path gtfs:message ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # pickup_message (Optional)
    sh:property [
        sh:path gtfs:pickup_message ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # drop_off_message (Optional)
    sh:property [
        sh:path gtfs:drop_off_message ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # phone_number (Optional)
    sh:property [
        sh:path gtfs:phone_number ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # info_url (Optional)
    sh:property [
        sh:path gtfs:info_url ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description """Optional"""
    ] ;

    # booking_url (Optional)
    sh:property [
        sh:path gtfs:booking_url ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description """Optional"""
    ] .

# ==========
# translations.txt
# ==========

gtfs:TranslationShape a sh:NodeShape ;
    sh:targetClass gtfs:Translation ;
    # table_name (Required)
    sh:property [
        sh:path gtfs:table_name ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "agency" "stops" "routes" "trips" "stop_times" "pathways" "levels" "feed_info" "attributions" ) ;
        sh:description """Required"""
    ] ;

    # field_name (Required)
    sh:property [
        sh:path gtfs:field_name ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] ;

    # language (Required)
    sh:property [
        sh:path gtfs:language ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*$" ;
        sh:description """Required"""
    ] ;

    # translation (Required)
    sh:property [
        sh:path gtfs:translation ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ; sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] [ sh:datatype xsd:string ] ) ;
        sh:description """Required"""
    ] ;

    # record_id (Conditionally Required)
    sh:property [
        sh:path gtfs:record_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Forbidden if table_name is feed_info. Forbidden if field_value is defined. Required if field_value is empty."""
    ] ;

    # rule: record_id: forbidden when table_name in ['feed_info']
    sh:or (
        [ sh:property [ sh:path gtfs:table_name ; sh:not [ sh:in ( "feed_info" ) ] ] ]
        [ sh:property [ sh:path gtfs:record_id ; sh:maxCount 0 ] ]
    ) ;

    # rule: record_id: forbidden when field_value is defined
    sh:or (
        [ sh:property [ sh:path gtfs:field_value ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:record_id ; sh:maxCount 0 ] ]
    ) ;

    # rule: record_id: required when field_value is empty
    sh:or (
        [ sh:property [ sh:path gtfs:field_value ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:record_id ; sh:minCount 1 ] ]
    ) ;

    # record_sub_id (Conditionally Required)
    sh:property [
        sh:path gtfs:record_sub_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Forbidden if table_name is feed_info. Forbidden if field_value is defined. Required if table_name=stop_times and record_id is defined."""
    ] ;

    # rule: record_sub_id: forbidden when table_name in ['feed_info']
    sh:or (
        [ sh:property [ sh:path gtfs:table_name ; sh:not [ sh:in ( "feed_info" ) ] ] ]
        [ sh:property [ sh:path gtfs:record_sub_id ; sh:maxCount 0 ] ]
    ) ;

    # rule: record_sub_id: forbidden when field_value is defined
    sh:or (
        [ sh:property [ sh:path gtfs:field_value ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:record_sub_id ; sh:maxCount 0 ] ]
    ) ;

    # rule: record_sub_id: required when table_name in ['stop_times'] and record_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:table_name ; sh:not [ sh:in ( "stop_times" ) ] ] ]
        [ sh:property [ sh:path gtfs:record_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:record_sub_id ; sh:minCount 1 ] ]
    ) ;

    # field_value (Conditionally Required)
    sh:property [
        sh:path gtfs:field_value ;
        sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] [ sh:datatype xsd:string ; sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ] [ sh:datatype xsd:string ] ) ;
        sh:description """Conditionally Required. Forbidden if table_name is feed_info. Forbidden if record_id is defined. Required if record_id is empty."""
    ] ;

    # rule: field_value: forbidden when table_name in ['feed_info']
    sh:or (
        [ sh:property [ sh:path gtfs:table_name ; sh:not [ sh:in ( "feed_info" ) ] ] ]
        [ sh:property [ sh:path gtfs:field_value ; sh:maxCount 0 ] ]
    ) ;

    # rule: field_value: forbidden when record_id is defined
    sh:or (
        [ sh:property [ sh:path gtfs:record_id ; sh:maxCount 0 ] ]
        [ sh:property [ sh:path gtfs:field_value ; sh:maxCount 0 ] ]
    ) ;

    # rule: field_value: required when record_id is empty
    sh:or (
        [ sh:property [ sh:path gtfs:record_id ; sh:minCount 1 ] ]
        [ sh:property [ sh:path gtfs:field_value ; sh:minCount 1 ] ]
    ) .

# ==========
# feed_info.txt
# ==========

gtfs:FeedInfoShape a sh:NodeShape ;
    sh:targetClass gtfs:FeedInfo ;
    # feed_publisher_name (Required)
    sh:property [
        sh:path gtfs:feed_publisher_name ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Required"""
    ] ;

    # feed_publisher_url (Required)
    sh:property [
        sh:path gtfs:feed_publisher_url ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description """Required"""
    ] ;

    # feed_lang (Required)
    sh:property [
        sh:path gtfs:feed_lang ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*$" ;
        sh:description """Required"""
    ] ;

    # default_lang (Optional)
    sh:property [
        sh:path gtfs:default_lang ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*$" ;
        sh:description """Optional"""
    ] ;

    # feed_start_date (Recommended)
    sh:property [
        sh:path gtfs:feed_start_date ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{8}$" ;
        sh:description """Recommended"""
