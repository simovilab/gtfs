    # feed_end_date (Recommended)
    sh:property [
        sh:path gtfs:feed_end_date ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d{8}$" ;
        sh:description """Recommended"""
    ] ;

    # feed_version (Recommended)
    sh:property [
        sh:path gtfs:feed_version ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Recommended"""
    ] ;

    # feed_contact_email (Optional)
    sh:property [
        sh:path gtfs:feed_contact_email ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" ;
        sh:description """Optional"""
    ] ;

    # feed_contact_url (Optional)
    sh:property [
        sh:path gtfs:feed_contact_url ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:description """Optional"""
    ] .

