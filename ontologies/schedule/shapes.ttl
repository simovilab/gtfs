# ==========
# transfers.txt
# ==========

gtfs:TransferShape a sh:NodeShape ;
    sh:targetClass gtfs:Transfer ;
    # from_stop_id (Conditionally Required)
    sh:property [
        sh:path gtfs:from_stop_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Required if transfer_type is empty, 0, 1, 2, or 3. Optional if transfer_type is 4 or 5."""
    ] ;

    # rule: from_stop_id: required when transfer_type in [0, 1, 2, 3]
    sh:or (
        [ sh:property [ sh:path gtfs:transfer_type ; sh:minCount 1 ; sh:not [ sh:in ( 0 1 2 3 ) ] ] ]
        [ sh:property [ sh:path gtfs:from_stop_id ; sh:minCount 1 ] ]
    ) ;

    # to_stop_id (Conditionally Required)
    sh:property [
        sh:path gtfs:to_stop_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Required if transfer_type is empty, 0, 1, 2, or 3. Optional if transfer_type is 4 or 5."""
    ] ;

    # rule: to_stop_id: required when transfer_type in [0, 1, 2, 3]
    sh:or (
        [ sh:property [ sh:path gtfs:transfer_type ; sh:minCount 1 ; sh:not [ sh:in ( 0 1 2 3 ) ] ] ]
        [ sh:property [ sh:path gtfs:to_stop_id ; sh:minCount 1 ] ]
    ) ;

    # from_route_id (Optional)
    sh:property [
        sh:path gtfs:from_route_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # to_route_id (Optional)
    sh:property [
        sh:path gtfs:to_route_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Optional"""
    ] ;

    # from_trip_id (Conditionally Required)
    sh:property [
        sh:path gtfs:from_trip_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Required if transfer_type is 4 or 5. Optional otherwise."""
    ] ;

    # rule: from_trip_id: required when transfer_type in [4, 5]
    sh:or (
        [ sh:property [ sh:path gtfs:transfer_type ; sh:not [ sh:in ( 4 5 ) ] ] ]
        [ sh:property [ sh:path gtfs:from_trip_id ; sh:minCount 1 ] ]
    ) ;

    # to_trip_id (Conditionally Required)
    sh:property [
        sh:path gtfs:to_trip_id ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:description """Conditionally Required. Required if transfer_type is 4 or 5. Optional otherwise."""
    ] ;

    # rule: to_trip_id: required when transfer_type in [4, 5]
    sh:or (
        [ sh:property [ sh:path gtfs:transfer_type ; sh:not [ sh:in ( 4 5 ) ] ] ]
        [ sh:property [ sh:path gtfs:to_trip_id ; sh:minCount 1 ] ]
    ) ;

    # transfer_type (Required)
    sh:property [
        sh:path gtfs:transfer_type ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:datatype xsd:integer ;
        sh:in ( 0 1 2 3 4 5 ) ;
        sh:description """Required"""
    ] ;

    # min_transfer_time (Conditionally Required)
    sh:property [
        sh:path gtfs:min_transfer_time ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:description """Conditionally Required. Required if transfer_type is 2. Optional otherwise."""
    ] ;

    # rule: min_transfer_time: required when transfer_type in [2]
    sh:or (
        [ sh:property [ sh:path gtfs:transfer_type ; sh:not [ sh:in ( 2 ) ] ] ]
        [ sh:property [ sh:path gtfs:min_transfer_time ; sh:minCount 1 ] ]
    ) .

