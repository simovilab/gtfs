<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
<style>
{{ style }}
</style>
</head>
<body>
<header><div class="hwrap">
  <h1 id="title">{{ heading }}<small id="subtitle"></small></h1>
  <nav class="pages">
    {%- for item in nav %}
    <a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>
    {%- endfor %}
  </nav>
  <div class="langs" id="langs"></div>
</div></header>

<main>
  <div class="bar">
    <p id="covtext"></p>
    <div class="meter"><i id="covbar"></i></div>
  </div>
  <div class="controls">
    <select id="table"></select>
    <input type="search" id="search" autocomplete="off">
  </div>
  <p class="tinfo" id="tinfo"></p>
  <div id="fields"></div>
  <div id="draftbar" hidden></div>
</main>

<dialog id="out"><div class="dwrap">
  <h2></h2>
  <p class="help hint"></p>
  <textarea readonly spellcheck="false"></textarea>
  <div class="acts">
    <button class="act primary" id="p-copy"></button>
    <button class="act" id="p-close"></button>
  </div>
</div></dialog>

<dialog id="ask"><div class="dwrap">
  <p class="msg"></p>
  <div class="acts">
    <button class="act primary" id="a-yes"></button>
    <button class="act" id="a-no"></button>
  </div>
</div></dialog>

<footer id="footer"></footer>

<script type="application/json" id="page">{{ page_json }}</script>
<script type="application/json" id="data">{{ data_json }}</script>
<script type="application/json" id="form-model">{{ form_json }}</script>
<script>
{{ state_js }}
{{ strings_js }}
{{ render_js }}
{{ suggest_js }}
{{ editor_js }}
{{ export_js }}

document.getElementById('table').onchange = e => {
  if (editing) closeForm(false);
  current = e.target.value;
  renderFields();
};
document.getElementById('search').oninput = renderFields;
window.addEventListener('beforeunload', e => {
  // Drafts survive a reload in localStorage, but an unsaved change that never
  // reached the YAML is still easy to forget about.
  if (changedKeys().length) e.preventDefault();
});

renderAll();
if (!openFromHash()) window.scrollTo({top: 0});
window.addEventListener('hashchange', openFromHash);
probeWriteAccess();
</script>
</body>
</html>
