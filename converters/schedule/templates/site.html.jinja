<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GTFS Schedule — Componentes de edición y validación</title>
<style>
:root{
  --bg:#f7f8fa; --panel:#fff; --ink:#16191f; --muted:#5d6470; --line:#dfe3e9;
  --accent:#1d5fd0; --accent-soft:#e8f0fe;
  --ok:#0f7a4d; --ok-soft:#e3f5ec; --warn:#8a5a00; --warn-soft:#fdf3dc;
  --gap:#7a4bb5; --gap-soft:#f0e9fa;
  --radius:10px; --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme:dark){
  :root{
    --bg:#12151a; --panel:#1a1e25; --ink:#e8eaed; --muted:#9aa2af; --line:#2b313b;
    --accent:#6fa0f5; --accent-soft:#1c2942;
    --ok:#5fd39b; --ok-soft:#122b20; --warn:#e5b567; --warn-soft:#2e2413;
    --gap:#b98ce8; --gap-soft:#251a33;
  }
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);
  font:15px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{background:var(--panel);border-bottom:1px solid var(--line);padding:16px 20px}
.hwrap{max-width:1100px;margin:0 auto;display:flex;flex-wrap:wrap;gap:12px;align-items:center}
h1{font-size:18px;margin:0;flex:1 1 260px;letter-spacing:-.01em}
h1 small{display:block;font-weight:400;font-size:13px;color:var(--muted);margin-top:2px}
.langs{display:flex;gap:4px}
.langs button{font:inherit;font-size:13px;padding:5px 11px;border:1px solid var(--line);
  background:transparent;color:var(--muted);border-radius:99px;cursor:pointer}
.langs button[aria-pressed=true]{background:var(--accent);border-color:var(--accent);color:#fff}
main{max-width:1100px;margin:0 auto;padding:18px 20px 64px}
.bar{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
  padding:14px 16px;margin-bottom:16px}
.bar p{margin:0 0 10px;font-size:13.5px;color:var(--muted)}
.meter{height:7px;background:var(--line);border-radius:99px;overflow:hidden}
.meter i{display:block;height:100%;background:var(--accent);border-radius:99px}
.controls{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px}
select,input[type=search]{font:inherit;padding:9px 11px;border:1px solid var(--line);
  border-radius:8px;background:var(--panel);color:var(--ink);min-width:0}
select{flex:1 1 260px}
input[type=search]{flex:2 1 220px}
.tinfo{font-size:13px;color:var(--muted);margin:0 0 12px}
.field{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);
  margin-bottom:8px;overflow:hidden}
.field>summary{cursor:pointer;padding:12px 14px;display:flex;flex-wrap:wrap;
  gap:8px;align-items:center;list-style:none}
.field>summary::-webkit-details-marker{display:none}
.field>summary:hover{background:var(--accent-soft)}
.fname{font-family:var(--mono);font-size:13.5px;font-weight:600;flex:1 1 auto;word-break:break-all}
.tag{font-size:11px;font-weight:600;padding:3px 8px;border-radius:99px;white-space:nowrap;
  letter-spacing:.02em}
.tag.type{background:var(--accent-soft);color:var(--accent)}
.tag.req{background:var(--warn-soft);color:var(--warn)}
.tag.comp{background:var(--ok-soft);color:var(--ok);font-family:var(--mono)}
.tag.gap{background:var(--gap-soft);color:var(--gap)}
.body{padding:0 14px 14px;border-top:1px solid var(--line)}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:14px}
@media (max-width:720px){.cols{grid-template-columns:1fr}}
.col h3{margin:0 0 8px;font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted)}
.col{border:1px solid var(--line);border-radius:8px;padding:12px;background:var(--bg)}
.desc{margin:0 0 10px;font-size:13.5px}
dl{margin:0;font-size:13px}
dl div{display:flex;gap:8px;padding:4px 0;border-top:1px dashed var(--line)}
dl div:first-child{border-top:0}
dt{color:var(--muted);flex:0 0 40%;font-weight:500}
dd{margin:0;flex:1 1 auto;font-family:var(--mono);font-size:12.5px;word-break:break-word}
ul.notes{margin:8px 0 0;padding-left:18px;font-size:12.5px;color:var(--muted)}
ul.notes li{margin-bottom:3px}
table.opts{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:6px}
table.opts td{padding:4px 6px;border-top:1px solid var(--line);vertical-align:top}
table.opts td:first-child{font-family:var(--mono);white-space:nowrap;color:var(--accent);width:1%}
.optcat{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);
  margin:8px 0 0}
.sev{font-size:10px;padding:1px 6px;border-radius:99px;background:var(--warn-soft);
  color:var(--warn);margin-left:6px;font-family:system-ui,sans-serif;font-weight:600}
.nomap{margin:0;font-size:13px;color:var(--muted)}
.nomap b{color:var(--gap)}
footer{max-width:1100px;margin:0 auto;padding:0 20px 40px;font-size:12.5px;color:var(--muted)}
footer code{font-family:var(--mono)}
.empty{padding:28px;text-align:center;color:var(--muted);background:var(--panel);
  border:1px solid var(--line);border-radius:var(--radius)}
</style>
</head>
<body>
<header><div class="hwrap">
  <h1 id="title">GTFS Schedule<small id="subtitle"></small></h1>
  <div class="langs" id="langs"></div>
</div></header>

<main>
  <div class="bar">
    <p id="covtext"></p>
    <div class="meter"><i id="covbar"></i></div>
  </div>
  <div class="controls">
    <select id="table"></select>
    <input type="search" id="search" autocomplete="off">
  </div>
  <p class="tinfo" id="tinfo"></p>
  <div id="fields"></div>
</main>

<footer id="footer"></footer>

<script type="application/json" id="data">{{ data_json }}</script>
{% raw %}
<script>
const DATA = JSON.parse(document.getElementById('data').textContent);

const STRINGS = {
  es: {
    subtitle: 'Componentes de edición y reglas de validación por campo',
    coverage: (a,t,p) => `${a} de ${t} campos tienen anotación de edición (${p}%). El resto aparece marcado como «aún no mapeado».`,
    search: 'Buscar campo…', spec: 'Especificación GTFS', editor: 'Editor propuesto',
    type: 'Tipo', presence: 'Presencia', conditions: 'Condiciones', notes: 'Notas',
    options: 'Opciones', component: 'Componente', group: 'Grupo', references: 'Referencia',
    validation: 'Validación', label: 'Etiqueta', help: 'Ayuda',
    nomap: 'Aún no mapeado', nomapLong: 'Este campo todavía no tiene componente de edición ni reglas de validación definidas.',
    noresults: 'Ningún campo coincide con la búsqueda.',
    fields: 'campos', annotated: 'anotados', bbox: 'Región',
    footer: 'Generado desde <code>serializers/schedule/schedule.yaml</code> (verdad de referencia GTFS) y <code>serializers/schedule/schedule.ui.yaml</code> (anotaciones de edición). Revisión de la especificación:'
  },
  en: {
    subtitle: 'Per-field editor components and validation rules',
    coverage: (a,t,p) => `${a} of ${t} fields have an editor annotation (${p}%). The rest are marked “not yet mapped”.`,
    search: 'Search field…', spec: 'GTFS specification', editor: 'Proposed editor',
    type: 'Type', presence: 'Presence', conditions: 'Conditions', notes: 'Notes',
    options: 'Options', component: 'Component', group: 'Group', references: 'References',
    validation: 'Validation', label: 'Label', help: 'Help',
    nomap: 'Not yet mapped', nomapLong: 'This field has no editor component or validation rules defined yet.',
    noresults: 'No field matches the search.',
    fields: 'fields', annotated: 'annotated', bbox: 'Region',
    footer: 'Generated from <code>serializers/schedule/schedule.yaml</code> (GTFS ground truth) and <code>serializers/schedule/schedule.ui.yaml</code> (editor annotations). Spec revision:'
  },
  pt: {
    subtitle: 'Componentes de edição e regras de validação por campo',
    coverage: (a,t,p) => `${a} de ${t} campos têm anotação de edição (${p}%). Os demais aparecem como “ainda não mapeado”.`,
    search: 'Buscar campo…', spec: 'Especificação GTFS', editor: 'Editor proposto',
    type: 'Tipo', presence: 'Presença', conditions: 'Condições', notes: 'Notas',
    options: 'Opções', component: 'Componente', group: 'Grupo', references: 'Referência',
    validation: 'Validação', label: 'Rótulo', help: 'Ajuda',
    nomap: 'Ainda não mapeado', nomapLong: 'Este campo ainda não tem componente de edição nem regras de validação definidas.',
    noresults: 'Nenhum campo corresponde à busca.',
    fields: 'campos', annotated: 'anotados', bbox: 'Região',
    footer: 'Gerado a partir de <code>serializers/schedule/schedule.yaml</code> (referência GTFS) e <code>serializers/schedule/schedule.ui.yaml</code> (anotações de edição). Revisão da especificação:'
  }
};

const LANG_NAMES = {es:'Español', en:'English', pt:'Português'};
let lang = 'es';

const esc = s => String(s == null ? '' : s).replace(/[&<>"]/g,
  c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

// Show annotated tables first so the demo scope is what you land on.
const tablesSorted = () => DATA.tables.slice().sort((a,b) =>
  (b.annotated > 0) - (a.annotated > 0) || a.name.localeCompare(b.name));

// Land on the first annotated table, not the first table in spec order.
let current = (tablesSorted()[0] || {}).name || null;

function renderLangs(){
  document.getElementById('langs').innerHTML = DATA.langs.map(l =>
    `<button data-l="${l}" aria-pressed="${l===lang}">${LANG_NAMES[l]||l}</button>`).join('');
  document.querySelectorAll('#langs button').forEach(b =>
    b.onclick = () => { lang = b.dataset.l; document.documentElement.lang = lang; renderAll(); });
}

function renderChrome(){
  const t = STRINGS[lang], c = DATA.coverage;
  document.getElementById('subtitle').textContent = t.subtitle;
  document.getElementById('covtext').textContent = t.coverage(c.annotated, c.total, c.percent);
  document.getElementById('covbar').style.width = Math.max(c.percent, 1.5) + '%';
  document.getElementById('search').placeholder = t.search;
  document.getElementById('footer').innerHTML =
    t.footer + ' ' + esc(DATA.metadata.revision_date || '');
  document.getElementById('table').innerHTML = tablesSorted().map(tb =>
    `<option value="${tb.name}"${tb.name===current?' selected':''}>${esc(tb.file)} — ${tb.annotated}/${tb.total} ${esc(t.annotated)}</option>`
  ).join('');
}

function validationRows(v){
  const t = STRINGS[lang];
  return Object.entries(v).map(([k, val]) => {
    let out, sev = '';
    if (k === 'bounding_box' && val && typeof val === 'object'){
      const r = DATA.regions[val.region] || {};
      const label = (r.label && (r.label[lang] || r.label.es)) || val.region;
      const box = (r.min_lat != null)
        ? ` — lat [${r.min_lat}, ${r.max_lat}], lon [${r.min_lon}, ${r.max_lon}]` : '';
      out = esc(label) + esc(box);
      sev = `<span class="sev">${esc(val.severity || 'warning')}</span>`;
    } else if (Array.isArray(val)) {
      out = esc('[' + val.join(', ') + ']');
    } else {
      out = esc(String(val));
    }
    return `<div><dt>${esc(k)}</dt><dd>${out}${sev}</dd></div>`;
  }).join('');
}

function optionsHtml(groups){
  return groups.map(g =>
    (g.category ? `<p class="optcat">${esc(g.category)}</p>` : '') +
    `<table class="opts">` + g.values.map(v =>
      `<tr><td>${esc(v.value)}</td><td>${esc(v.description)}</td></tr>`).join('') + `</table>`
  ).join('');
}

function fieldHtml(f){
  const t = STRINGS[lang], a = f.annotation;
  const i18n = a && (a.i18n[lang] || a.i18n.es || {});

  const head = `<summary>
    <span class="fname">${esc(f.name)}</span>
    <span class="tag type">${esc(f.type)}</span>
    ${f.presence ? `<span class="tag req">${esc(f.presence)}</span>` : ''}
    ${a ? `<span class="tag comp">${esc(a.component)}</span>`
        : `<span class="tag gap">${esc(t.nomap)}</span>`}
  </summary>`;

  const specCol = `<div class="col"><h3>${esc(t.spec)}</h3>
    <p class="desc">${esc(f.description)}</p>
    <dl>
      <div><dt>${esc(t.type)}</dt><dd>${esc(f.type)}</dd></div>
      <div><dt>${esc(t.presence)}</dt><dd>${esc(f.presence)}</dd></div>
    </dl>
    ${f.conditions.length ? `<p class="optcat">${esc(t.conditions)}</p>
      <ul class="notes">${f.conditions.map(c=>`<li>${esc(c)}</li>`).join('')}</ul>` : ''}
    ${f.notes.length ? `<p class="optcat">${esc(t.notes)}</p>
      <ul class="notes">${f.notes.map(c=>`<li>${esc(c)}</li>`).join('')}</ul>` : ''}
    ${f.options.length ? `<p class="optcat">${esc(t.options)}</p>${optionsHtml(f.options)}` : ''}
  </div>`;

  const editorCol = `<div class="col"><h3>${esc(t.editor)}</h3>` + (a ? `
    ${i18n.help ? `<p class="desc">${esc(i18n.help)}</p>` : ''}
    <dl>
      <div><dt>${esc(t.label)}</dt><dd>${esc(i18n.label || '')}</dd></div>
      <div><dt>${esc(t.component)}</dt><dd>${esc(a.component)}</dd></div>
      ${a.group ? `<div><dt>${esc(t.group)}</dt><dd>${esc(a.group)}</dd></div>` : ''}
      ${a.references ? `<div><dt>${esc(t.references)}</dt><dd>${esc(a.references)}</dd></div>` : ''}
    </dl>
    <p class="optcat">${esc(t.validation)}</p>
    <dl>${validationRows(a.validation)}</dl>`
    : `<p class="nomap"><b>${esc(t.nomap)}.</b> ${esc(t.nomapLong)}</p>`) + `</div>`;

  return `<details class="field">${head}
    <div class="body"><div class="cols">${specCol}${editorCol}</div></div></details>`;
}

function renderFields(){
  const t = STRINGS[lang];
  const tb = DATA.tables.find(x => x.name === current);
  const q = document.getElementById('search').value.trim().toLowerCase();
  const info = document.getElementById('tinfo');
  if (!tb){ document.getElementById('fields').innerHTML = ''; info.textContent=''; return; }

  info.textContent = `${tb.file} · ${tb.total} ${t.fields} · ${tb.annotated} ${t.annotated}`
    + (tb.presence ? ` · ${tb.presence}` : '');

  const shown = tb.fields.filter(f => !q
    || f.name.toLowerCase().includes(q)
    || (f.description || '').toLowerCase().includes(q));

  document.getElementById('fields').innerHTML = shown.length
    ? shown.map(fieldHtml).join('')
    : `<div class="empty">${esc(t.noresults)}</div>`;
}

function renderAll(){ renderLangs(); renderChrome(); renderFields(); }

document.getElementById('table').onchange = e => { current = e.target.value; renderFields(); };
document.getElementById('search').oninput = renderFields;
renderAll();
</script>
{% endraw %}
</body>
</html>
